# Se desarrolla en Windows y se despliega en Linux (Lambda). Con core.autocrlf=true
# el working copy usa CRLF, pero en el repositorio todo queda normalizado a LF.
* text=auto eol=lf

# Los scripts deben conservar LF o no se ejecutan en Linux.
*.sh text eol=lf

# Binarios: git no debe tocarlos.
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.webm binary
*.zip binary
