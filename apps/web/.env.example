# Plantilla de configuracion del frontend.
#
# NO copies este archivo a mano: ejecuta `bash scripts/gen-env.sh` desde la raiz.
# El .env real esta cubierto por .gitignore.
#
# Solo las variables con prefijo VITE_ llegan al navegador. Ninguna de estas es
# secreta: son identificadores publicos que viajan en el paquete descargado.

VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
