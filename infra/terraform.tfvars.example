# Plantilla de variables. Copia este archivo a terraform.tfvars y ajusta lo que
# necesites. terraform.tfvars NO se versiona: esta cubierto por .gitignore.
#
# Todos los valores tienen un default razonable en variables.tf, asi que este
# archivo solo hace falta si quieres desviarte de ellos.

# aws_region   = "us-east-1"
# project_name = "educacion-estrella"

# Origenes del navegador para la subida directa al almacenamiento. El dominio de
# la distribucion NO va aqui: se anade solo, porque se conoce al aplicar.
# allowed_upload_origins = ["http://localhost:5173"]

# Este entorno es desechable y se destruye al terminar la prueba. En cualquier
# entorno real esto se queda en false, que es el valor por omision.
videos_bucket_force_destroy = true

# Tope de ejecuciones simultaneas de la API.
# api_reserved_concurrency = 10
