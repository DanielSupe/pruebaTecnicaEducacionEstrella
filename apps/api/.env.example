# Plantilla de configuracion de la API.
#
# La forma normal de generar el .env real es `bash scripts/gen-env.sh` desde la
# raiz: lee las salidas de Terraform, que son la unica fuente de verdad de los
# identificadores de infraestructura, y evita transcribirlos a mano.
#
# Esta plantilla existe para el caso en que la infraestructura ya exista y no
# tengas Terraform: copia este archivo a .env y rellena los valores.
#
# El .env real esta cubierto por .gitignore.

# --- Identificadores de infraestructura -------------------------------------
# Los genera gen-env.sh. Ninguno tiene valor por omision a proposito: apuntar al
# recurso equivocado parece funcionar hasta que no funciona.

AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
APPLICATIONS_TABLE_NAME=educacion-estrella-applications
VIDEOS_BUCKET_NAME=educacion-estrella-videos-xxxxxxxx

# --- Del entorno local ------------------------------------------------------

# Origenes autorizados a llamar a la API desde el navegador, separados por comas.
# Obligatoria y sin valor por omision: un default aqui significaria desplegar con
# los origenes equivocados sin enterarse.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Opcionales en desarrollo.
# PORT=3000
# NODE_ENV=development

# --- Credenciales -----------------------------------------------------------
# NO van aqui. El SDK las resuelve del entorno o del perfil configurado, igual
# que hace el CLI de aws. Este archivo no debe contener ninguna clave.
